<?xml version="1.0" ?>
<!--
  Stage-1 exploration scene.

  Layout (in world frame, JAKA A5 base at z = 0.05):
    - ground plane + sun (Gazebo defaults)
    - a single brown box, 0.40 x 0.30 x 0.40 m,
      placed 60 cm in front of the robot, centered on the y=0 line,
      so the arm has to look around it to map what is behind.

  Adjust `box_target` <pose> below to move the obstacle. We will swap this
  for the bookshelf / drill / medicalBox meshes in a later stage.
-->
<sdf version="1.9">
  <world name="exploration_scene">

    <!-- physics + lighting (standard Gazebo Harmonic defaults) -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.4 -0.9</direction>
    </light>

    <!-- ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- target box (Stage-1 placeholder; ~ shoebox size, brown).
         Placed at x=0.85 so it does NOT overlap the JAKA A5's initial
         folded pose (joint_2=+90°, joint_3=-90° puts the elbow around
         x=0.35-0.4). With box near-edge at x=0.65 the start state is
         collision-free, and the box is still well within the 800 mm
         reach so the wrist can sweep around it. -->
    <model name="box_target">
      <static>true</static>
      <pose>0.85 0.0 0.20 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.40 0.30 0.40</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.65 0.48 0.30 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.40 0.30 0.40</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
