<?xml version="1.0" ?>
<!--
  Multi-object exploration scene. Same as exploration_scene.sdf but with
  an extra green sphere on the LEFT (+Y) of the arm and a red cylinder
  on the RIGHT (-Y).

  Layout (world frame, JAKA A5 base at origin, reach ~0.86 m):
    - box_target (brown):  (0.85, 0.00, 0.20)  0.40 x 0.30 x 0.40   FRONT
    - sphere_left (green): (0.50, 0.60, 0.15)  r=0.10               LEFT
    - cyl_right (red):     (0.50,-0.60, 0.15)  r=0.08, h=0.30       RIGHT

  All three fit inside the JAKA A5 reachable sphere while sitting
  outside the arm's initial folded pose so the start state is
  collision-free.
-->
<sdf version="1.9">
  <world name="exploration_scene_multi">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.4 -0.9</direction>
    </light>

    <!-- ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- box in front (unchanged from single-object scene) -->
    <model name="box_target">
      <static>true</static>
      <pose>0.85 0.0 0.20 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.40 0.30 0.40</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.65 0.48 0.30 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.40 0.30 0.40</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- sphere on the arm's LEFT (+Y), green -->
    <model name="sphere_left">
      <static>true</static>
      <pose>0.50 0.60 0.15 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><sphere><radius>0.10</radius></sphere></geometry>
          <material>
            <ambient>0.20 0.55 0.25 1</ambient>
            <diffuse>0.25 0.70 0.30 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><sphere><radius>0.10</radius></sphere></geometry>
        </collision>
      </link>
    </model>

    <!-- cylinder on the arm's RIGHT (-Y), red -->
    <model name="cyl_right">
      <static>true</static>
      <pose>0.50 -0.60 0.15 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.30</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.60 0.15 0.15 1</ambient>
            <diffuse>0.80 0.20 0.20 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.30</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
