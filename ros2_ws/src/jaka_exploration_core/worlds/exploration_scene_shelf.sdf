<?xml version="1.0" ?>
<!--
  RealShelf exploration scene. Same physics/lighting/ground as the
  other scenes, but the ONLY object is a RealShelf mesh in front of
  the JAKA A5.

  Mesh dimensions (from RealShelf.obj vertex extents):
    local x: [-0.42, +0.42]  (width, 0.84 m)
    local y: [ 0.00,  0.39]  (depth, 0.39 m)
    local z: [ 0.00,  1.11]  (height, 1.11 m)

  Placement: yaw = pi/2 rotates the shelf so its local +Y (front /
  opening direction) points toward world -X (i.e. toward the arm at
  the origin). Translation (0.99, 0, 0) then puts the SHELF FRONT at
  world x = 0.99 - 0.39 = 0.60 m, comfortably beyond the arm's initial
  folded pose (wrist near x = 0.48) and inside JAKA A5's 0.86 m reach.

  If the mesh's opening turns out to be on the OTHER local face, flip
  the yaw sign or add pi to make it face the arm.
-->
<sdf version="1.9">
  <world name="exploration_scene_shelf">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.4 -0.9</direction>
    </light>

    <!-- ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- RealShelf, in front of the arm, opening facing back at the arm.
         yaw = -pi/2 (was +pi/2) flips the shelf 180 deg around Z so the
         opening (local y=0 face) faces world -X (toward the arm) rather
         than +X (away from it). Translation moved from x=0.99 to
         x=0.80 so the shelf front sits ~0.32 m from the arm's initial
         wrist position - slightly farther than before but still well
         inside the camera's 3 m sensing range. -->
    <model name="real_shelf">
      <static>true</static>
      <pose>0.80 0.0 0.0  0 0 -1.5708</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <mesh>
              <uri>package://jaka_exploration_core/meshes/RealShelf.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.65 0.48 0.30 1</diffuse>
          </material>
        </visual>
        <!-- Collision uses a bounding box, NOT the mesh. The RealShelf
             .obj was exported from SolidWorks without vertex normals;
             DART (dartsim) segfaults on it when it tries to build a
             collision mesh, taking Gazebo down with it and stranding
             controller_manager. Visual can still use the mesh because
             the renderer only warns about the missing material. The
             box has to be offset by (0, 0.195, 0.555) because the mesh
             origin is at the corner (front-bottom-centre), not the
             centre of the bounding volume. -->
        <collision name="c">
          <pose>0 0.195 0.555 0 0 0</pose>
          <geometry>
            <box>
              <size>0.84 0.39 1.11</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Ceiling slab at 1.5 m. The slab is 5 cm thick with its BOTTOM face
         at z = 1.50 m (pose z = 1.50 + 0.05/2 = 1.525), i.e. 1.5 m of clear
         headroom below it — 0.39 m above the 1.11 m shelf top. It spans
         6.0 x 6.0 m centred at (0.2, 0.0) (radius 3.0 m, 3x the previous
         1.0 m), covering the arm + shelf and well beyond the planning region
         (bounds x[-0.8,1.2], y[-1,1]). Collision uses a box (no mesh),
         matching ground_plane / real_shelf. To change the height, edit the
         pose z (= desired underside + 0.025); to make it centred at 1.5 m
         instead, set pose z = 1.5. -->
    <model name="ceiling">
      <static>true</static>
      <pose>0.2 0.0 1.525  0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <box><size>6.0 6.0 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.60 0.60 0.62 1</ambient>
            <diffuse>0.70 0.70 0.72 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry>
            <box><size>6.0 6.0 0.05</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ★★★ PERIMETER WALLS: 给水平向外的深度射线一个"命中点",否则打向
         开阔空间的射线返回 NaN → 该方向不生成射线 → 沿途 unknown 永远不被
         清成 free。四面墙贴着天花板的 6x6 footprint(x∈[-2.8,3.2],y∈[±3]),
         z 从地板 0 顶到天花板顶 1.55(与天花板 z[1.5,1.55] 重叠、与地板 z=0
         相接,无空隙)。位于 ~3m 外,不遮挡中心 arm/货架的 RViz 观察。
         东/西墙沿 y 拉到 6.2、南/北墙沿 x 拉到 6.2,使四角重叠密封。 -->
    <model name="wall_east">
      <static>true</static>
      <pose>3.2 0.0 0.775  0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.10 6.20 1.55</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.10 6.20 1.55</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-2.8 0.0 0.775  0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.10 6.20 1.55</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.10 6.20 1.55</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>0.2 3.0 0.775  0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>6.20 0.10 1.55</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>6.20 0.10 1.55</size></box></geometry></collision>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0.2 -3.0 0.775  0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>6.20 0.10 1.55</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>6.20 0.10 1.55</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
