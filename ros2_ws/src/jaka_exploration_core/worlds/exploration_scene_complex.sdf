<?xml version="1.0" ?>
<!--
  COMPLEX exploration scene (referenced from exploration_scene_shelf.sdf).
  Same physics / lighting / ground / RealShelf as the shelf scene, PLUS four
  deliberately hard-to-observe structures that stress viewpoint selection:

    1. real_shelf + shelf_blocks : the shelf, now with several small blocks
       at different heights/depths (occlusion + multi-target).
    2. grille       : a vertical louver panel with narrow gaps. A target block
       sits BEHIND it — only visible when the camera looks nearly perpendicular
       to the panel so its rays thread the ~5 cm gaps (可穿过观察的格栅).
    3. pipe         : a square tube open at both ends, wall-occluded. A target
       sits deep inside near the far end — only visible when the camera is
       aligned with the tube axis, i.e. facing the mouth (正对管口才能观察的粗管).
    4. cubby        : an upward-opening box with a TALL front wall on the arm
       side. The target sits on its floor; the front wall blocks any low/side
       view, so the camera must climb ABOVE the wall and look back down INTO it
       (越过障碍物反过来向里才能观察的结构).

  World frame: arm base at origin, +X points in front of the arm. The shelf
  occupies world x[0.80,1.19] y[-0.42,0.42] z[0,1.11], opening (-X) facing the
  arm. All new structures live at x<0.80 (front) or |y|>0.42 (sides) so they do
  not overlap the shelf. Every collision is a BOX (the RealShelf mesh keeps its
  box collision) to avoid the DART mesh segfault.

  Run with:
    ros2 launch jaka_exploration_core exploration_stage2.launch.py \
        world_file:=exploration_scene_complex.sdf
-->
<sdf version="1.9">
  <world name="exploration_scene_complex">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.4 -0.9</direction>
    </light>

    <!-- ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
      </link>
    </model>

    <!-- ================= 1. RealShelf (same as shelf scene) ================= -->
    <model name="real_shelf">
      <static>true</static>
      <pose>0.80 0.0 0.0  0 0 -1.5708</pose>
      <link name="link">
        <visual name="v">
          <geometry>
            <mesh>
              <uri>package://jaka_exploration_core/meshes/RealShelf.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.65 0.48 0.30 1</diffuse>
          </material>
        </visual>
        <collision name="c">
          <pose>0 0.195 0.555 0 0 0</pose>
          <geometry>
            <box><size>0.84 0.39 1.11</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Blocks on/around the shelf front at several heights & depths. Bright
         so they read clearly; they create occlusion + multiple small targets. -->
    <model name="shelf_blocks">
      <static>true</static>
      <link name="link">
        <visual name="bA_v"><pose>0.66 0.24 0.36 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material><ambient>0.85 0.45 0.10 1</ambient><diffuse>0.95 0.55 0.15 1</diffuse></material></visual>
        <collision name="bA_c"><pose>0.66 0.24 0.36 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry></collision>

        <visual name="bB_v"><pose>0.70 -0.22 0.64 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <material><ambient>0.15 0.70 0.25 1</ambient><diffuse>0.20 0.85 0.30 1</diffuse></material></visual>
        <collision name="bB_c"><pose>0.70 -0.22 0.64 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry></collision>

        <visual name="bC_v"><pose>0.64 0.06 0.92 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.20 0.35 0.85 1</ambient><diffuse>0.25 0.45 0.95 1</diffuse></material></visual>
        <collision name="bC_c"><pose>0.64 0.06 0.92 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry></collision>

        <visual name="bD_v"><pose>0.72 0.30 0.30 0 0 0</pose>
          <geometry><box><size>0.05 0.10 0.05</size></box></geometry>
          <material><ambient>0.55 0.20 0.65 1</ambient><diffuse>0.65 0.25 0.80 1</diffuse></material></visual>
        <collision name="bD_c"><pose>0.72 0.30 0.30 0 0 0</pose>
          <geometry><box><size>0.05 0.10 0.05</size></box></geometry></collision>
      </link>
    </model>

    <!-- ================= 2. Grille (see-through louvers) =================
         Vertical panel in the world x-plane at x=0.44, on the +Y side. Five
         thin vertical slats (0.012 wide) spaced 0.06 apart leave ~0.048 gaps.
         A red target sits BEHIND it at x=0.56. From x<0.44 looking +X the
         camera only sees the target through the narrow gaps -> must look
         near-perpendicular to thread them. -->
    <model name="grille">
      <static>true</static>
      <link name="link">
        <!-- frame: two posts + top/bottom rails (y 0.40..0.62, z 0.33..0.67) -->
        <visual name="post_l_v"><pose>0.44 0.39 0.50 0 0 0</pose><geometry><box><size>0.03 0.02 0.36</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.30 0.30 0.34 1</diffuse></material></visual>
        <collision name="post_l_c"><pose>0.44 0.39 0.50 0 0 0</pose><geometry><box><size>0.03 0.02 0.36</size></box></geometry></collision>
        <visual name="post_r_v"><pose>0.44 0.63 0.50 0 0 0</pose><geometry><box><size>0.03 0.02 0.36</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.30 0.30 0.34 1</diffuse></material></visual>
        <collision name="post_r_c"><pose>0.44 0.63 0.50 0 0 0</pose><geometry><box><size>0.03 0.02 0.36</size></box></geometry></collision>
        <visual name="rail_t_v"><pose>0.44 0.51 0.67 0 0 0</pose><geometry><box><size>0.03 0.26 0.02</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.30 0.30 0.34 1</diffuse></material></visual>
        <collision name="rail_t_c"><pose>0.44 0.51 0.67 0 0 0</pose><geometry><box><size>0.03 0.26 0.02</size></box></geometry></collision>
        <visual name="rail_b_v"><pose>0.44 0.51 0.33 0 0 0</pose><geometry><box><size>0.03 0.26 0.02</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.30 0.30 0.34 1</diffuse></material></visual>
        <collision name="rail_b_c"><pose>0.44 0.51 0.33 0 0 0</pose><geometry><box><size>0.03 0.26 0.02</size></box></geometry></collision>
        <!-- 5 vertical slats at y = 0.42,0.48,0.51,0.54,0.60 -->
        <visual name="s1_v"><pose>0.44 0.42 0.50 0 0 0</pose><geometry><box><size>0.03 0.012 0.32</size></box></geometry><material><ambient>0.30 0.30 0.33 1</ambient><diffuse>0.36 0.36 0.40 1</diffuse></material></visual>
        <collision name="s1_c"><pose>0.44 0.42 0.50 0 0 0</pose><geometry><box><size>0.03 0.012 0.32</size></box></geometry></collision>
        <visual name="s2_v"><pose>0.44 0.48 0.50 0 0 0</pose><geometry><box><size>0.03 0.012 0.32</size></box></geometry><material><ambient>0.30 0.30 0.33 1</ambient><diffuse>0.36 0.36 0.40 1</diffuse></material></visual>
        <collision name="s2_c"><pose>0.44 0.48 0.50 0 0 0</pose><geometry><box><size>0.03 0.012 0.32</size></box></geometry></collision>
        <visual name="s3_v"><pose>0.44 0.54 0.50 0 0 0</pose><geometry><box><size>0.03 0.012 0.32</size></box></geometry><material><ambient>0.30 0.30 0.33 1</ambient><diffuse>0.36 0.36 0.40 1</diffuse></material></visual>
        <collision name="s3_c"><pose>0.44 0.54 0.50 0 0 0</pose><geometry><box><size>0.03 0.012 0.32</size></box></geometry></collision>
        <visual name="s4_v"><pose>0.44 0.60 0.50 0 0 0</pose><geometry><box><size>0.03 0.012 0.32</size></box></geometry><material><ambient>0.30 0.30 0.33 1</ambient><diffuse>0.36 0.36 0.40 1</diffuse></material></visual>
        <collision name="s4_c"><pose>0.44 0.60 0.50 0 0 0</pose><geometry><box><size>0.03 0.012 0.32</size></box></geometry></collision>
      </link>
    </model>
    <model name="grille_target">
      <static>true</static>
      <pose>0.56 0.51 0.50 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.12 0.12 0.12</size></box></geometry>
          <material><ambient>0.85 0.12 0.12 1</ambient><diffuse>0.95 0.15 0.15 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.12 0.12 0.12</size></box></geometry></collision>
      </link>
    </model>

    <!-- ================= 3. Pipe (face-the-mouth) =================
         Square tube along X on the -Y side (y=-0.52), inner channel
         0.12x0.12, walls 0.02, length 0.30 (x 0.42..0.72). Open at both ends;
         the arm-side mouth is at x=0.42 facing -X. A yellow target sits deep
         inside near the far end (x=0.68). Only a camera aligned with the tube
         axis (looking +X from ~x<0.42, y=-0.52, z=0.40) can see it; off-axis
         views are blocked by the walls. -->
    <model name="pipe">
      <static>true</static>
      <link name="link">
        <visual name="top_v"><pose>0.57 -0.52 0.47 0 0 0</pose><geometry><box><size>0.30 0.16 0.02</size></box></geometry><material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.50 0.52 0.56 1</diffuse></material></visual>
        <collision name="top_c"><pose>0.57 -0.52 0.47 0 0 0</pose><geometry><box><size>0.30 0.16 0.02</size></box></geometry></collision>
        <visual name="bot_v"><pose>0.57 -0.52 0.33 0 0 0</pose><geometry><box><size>0.30 0.16 0.02</size></box></geometry><material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.50 0.52 0.56 1</diffuse></material></visual>
        <collision name="bot_c"><pose>0.57 -0.52 0.33 0 0 0</pose><geometry><box><size>0.30 0.16 0.02</size></box></geometry></collision>
        <visual name="left_v"><pose>0.57 -0.59 0.40 0 0 0</pose><geometry><box><size>0.30 0.02 0.14</size></box></geometry><material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.50 0.52 0.56 1</diffuse></material></visual>
        <collision name="left_c"><pose>0.57 -0.59 0.40 0 0 0</pose><geometry><box><size>0.30 0.02 0.14</size></box></geometry></collision>
        <visual name="right_v"><pose>0.57 -0.45 0.40 0 0 0</pose><geometry><box><size>0.30 0.02 0.14</size></box></geometry><material><ambient>0.40 0.42 0.45 1</ambient><diffuse>0.50 0.52 0.56 1</diffuse></material></visual>
        <collision name="right_c"><pose>0.57 -0.45 0.40 0 0 0</pose><geometry><box><size>0.30 0.02 0.14</size></box></geometry></collision>
      </link>
    </model>
    <model name="pipe_target">
      <static>true</static>
      <pose>0.68 -0.52 0.40 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material><ambient>0.90 0.80 0.05 1</ambient><diffuse>0.98 0.90 0.10 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.08 0.08 0.08</size></box></geometry></collision>
      </link>
    </model>

    <!-- ================= 4. Cubby (over-and-back) =================
         An upward-opening box (x 0.55..0.75, y -0.13..0.13) with a TALL front
         wall on the arm side (x=0.55, z 0.40..0.70). Floor at z=0.40, side and
         back walls only 0.20 tall (z 0.40..0.60). No roof. A magenta target
         sits on the floor. The tall front wall blocks any direct/low/side view
         from the arm; the camera must climb ABOVE the front wall (z>0.70) and
         look DOWN/back into the opening to see the target. -->
    <model name="cubby">
      <static>true</static>
      <link name="link">
        <!-- tall front wall (arm side) -->
        <visual name="front_v"><pose>0.55 0.0 0.55 0 0 0</pose><geometry><box><size>0.02 0.28 0.30</size></box></geometry><material><ambient>0.45 0.35 0.22 1</ambient><diffuse>0.55 0.42 0.28 1</diffuse></material></visual>
        <collision name="front_c"><pose>0.55 0.0 0.55 0 0 0</pose><geometry><box><size>0.02 0.28 0.30</size></box></geometry></collision>
        <!-- floor -->
        <visual name="floor_v"><pose>0.65 0.0 0.40 0 0 0</pose><geometry><box><size>0.22 0.28 0.02</size></box></geometry><material><ambient>0.45 0.35 0.22 1</ambient><diffuse>0.55 0.42 0.28 1</diffuse></material></visual>
        <collision name="floor_c"><pose>0.65 0.0 0.40 0 0 0</pose><geometry><box><size>0.22 0.28 0.02</size></box></geometry></collision>
        <!-- back wall (far side, short) -->
        <visual name="back_v"><pose>0.75 0.0 0.50 0 0 0</pose><geometry><box><size>0.02 0.28 0.20</size></box></geometry><material><ambient>0.45 0.35 0.22 1</ambient><diffuse>0.55 0.42 0.28 1</diffuse></material></visual>
        <collision name="back_c"><pose>0.75 0.0 0.50 0 0 0</pose><geometry><box><size>0.02 0.28 0.20</size></box></geometry></collision>
        <!-- side walls (short) -->
        <visual name="sl_v"><pose>0.65 0.13 0.50 0 0 0</pose><geometry><box><size>0.22 0.02 0.20</size></box></geometry><material><ambient>0.45 0.35 0.22 1</ambient><diffuse>0.55 0.42 0.28 1</diffuse></material></visual>
        <collision name="sl_c"><pose>0.65 0.13 0.50 0 0 0</pose><geometry><box><size>0.22 0.02 0.20</size></box></geometry></collision>
        <visual name="sr_v"><pose>0.65 -0.13 0.50 0 0 0</pose><geometry><box><size>0.22 0.02 0.20</size></box></geometry><material><ambient>0.45 0.35 0.22 1</ambient><diffuse>0.55 0.42 0.28 1</diffuse></material></visual>
        <collision name="sr_c"><pose>0.65 -0.13 0.50 0 0 0</pose><geometry><box><size>0.22 0.02 0.20</size></box></geometry></collision>
      </link>
    </model>
    <model name="cubby_target">
      <static>true</static>
      <pose>0.65 0.0 0.45 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <material><ambient>0.80 0.10 0.70 1</ambient><diffuse>0.92 0.15 0.82 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.07 0.07 0.07</size></box></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
