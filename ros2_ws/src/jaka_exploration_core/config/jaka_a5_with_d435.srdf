<?xml version="1.0"?>
<!--
  Extended SRDF for the JAKA A5 + D435 setup.

  Copied verbatim from jaka_a5_moveit_config/config/jaka_a5.srdf
  (teammate's file) with EXTRA <disable_collisions> entries for the
  links we added in jaka_exploration_description/urdf/jaka_a5_with_d435.urdf.xacro
  — namely `camera_link` (and its optical frame).

  Without these disables, MoveIt's CheckStartStateCollision adapter
  reports a contact between `J6` and `camera_link` and refuses to plan
  (error code -10, START_STATE_IN_COLLISION). The camera box is
  physically bolted on the flange so allowing this contact is correct.
-->
<robot name="jaka_a5">
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <group name="jaka_a5">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <group_state name="zero" group="jaka_a5">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="0"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0"/>
    <joint name="joint_6" value="0"/>
  </group_state>
  <group_state name="ready" group="jaka_a5">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="1.5707"/>
    <joint name="joint_3" value="-1.5707"/>
    <joint name="joint_4" value="1.5707"/>
    <joint name="joint_5" value="1.5707"/>
    <joint name="joint_6" value="0"/>
  </group_state>

  <!-- Original (teammate) -->
  <disable_collisions link1="base_link" link2="J1" reason="Adjacent"/>
  <disable_collisions link1="J1" link2="J2" reason="Adjacent"/>
  <disable_collisions link1="J1" link2="J4" reason="Never"/>
  <disable_collisions link1="J2" link2="J3" reason="Adjacent"/>
  <disable_collisions link1="J3" link2="J4" reason="Adjacent"/>
  <disable_collisions link1="J3" link2="J5" reason="Never"/>
  <disable_collisions link1="J4" link2="J5" reason="Adjacent"/>
  <disable_collisions link1="J4" link2="J6" reason="Never"/>
  <disable_collisions link1="J5" link2="J6" reason="Adjacent"/>
  <disable_collisions link1="J6" link2="tool0" reason="Adjacent"/>

  <!-- Added: the D435 camera is rigidly bolted on the flange, so contact
       between the camera body and the surrounding wrist links is expected
       and must not block planning. -->
  <disable_collisions link1="J6" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="J5" link2="camera_link" reason="Never"/>
  <disable_collisions link1="J4" link2="camera_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="camera_link" reason="Adjacent"/>
</robot>
